# Backend Django - demo de vibraciones v1.1.0
# Copiar a .env y completar secretos. No compartir el archivo real.
DJANGO_SECRET_KEY=REEMPLAZAR_POR_CLAVE_ALEATORIA_LARGA
DJANGO_DEBUG=0
# Aqui va la IP del EQUIPO DONDE CORRE DJANGO, no necesariamente la de SQL.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,10.10.17.13
DJANGO_TIME_ZONE=America/Mexico_City
VIBRATIONS_API_KEY=REEMPLAZAR_POR_API_KEY_ALEATORIA_LARGA
# Agregar origen del dashboard React real si se usara desde otro equipo.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Misma conexion de Node-RED: MantenimientoPredictivo - SQLEXPRESS.
SQL_HOST=10.10.17.13
SQL_PORT=1433
SQL_DATABASE=MantenimientoPredictivo
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_AUTH=sql
SQL_USERNAME=USUARIO_SQL_CON_PERMISOS_MINIMOS
SQL_PASSWORD=REEMPLAZAR_CON_CREDENCIAL_REAL
# Esquema de la demo actual en Node-RED: Encrypt desactivado / Trust Certificate activado.
# EN PRODUCCION: usar TLS verificado, certificado valido, Encrypt=yes y Trust=no.
SQL_ENCRYPT=no
SQL_TRUST_SERVER_CERTIFICATE=yes
SQL_POOLING=no
SQL_CONNECTION_TIMEOUT=5
SQL_QUERY_TIMEOUT=20

VIBRATIONS_MODEL_DIR=artifacts
VIBRATIONS_MIN_RPM=300
VIBRATIONS_SCORE_WARNING=60
VIBRATIONS_SCORE_ALERT=85
VIBRATIONS_MIN_TRAIN_SAMPLES=300
VIBRATIONS_MIN_TRAIN_MINUTES=15
# Incluir contexto VFD solo si esta completo, tiene variabilidad y hay datos validos.
VIBRATIONS_USE_VFD_CONTEXT=1
