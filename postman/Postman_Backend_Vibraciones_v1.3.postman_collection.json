  },
  "item": [
    {
      "name": "01 - Estado del servidor",
      "item": [
        {
          "name": "GET - Salud / Conexión SQL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "Comprueba la disponibilidad de Django y la conexión con SQL Server. Respuesta: estado, sql y version. HTTP 200 si SQL responde, 503 si hay degradación.\n\nMétodo: GET. Body: none. No requiere X-API-Key."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"La respuesta es JSON\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Content-Type\") || \"\").to.include(\"application/json\");",
                  "});",
                  "if (pm.response.code !== 200) {",
                  "  console.warn(\"HTTP \" + pm.response.code + \": \" + pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
